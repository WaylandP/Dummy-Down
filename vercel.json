{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "content/*": false,
      "launch/*": false,
      "docs/*": false,
      "ci/*": false,
      "design/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false,
      "test/*": false,
      "screenshots": false,
      "archive/*": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/learn",
      "destination": "/index.html"
    },
    {
      "source": "/glossary",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/coverage",
      "destination": "/index.html"
    },
    {
      "source": "/practice",
      "destination": "/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/index.html"
    },
    {
      "source": "/timeline",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/controls",
      "destination": "/learn?view=discover&collection=references",
      "permanent": true
    }
  ]
}
