{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "content/*": false,
      "launch/*": false,
      "docs/*": false,
      "ci/*": false,
      "design/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false,
      "test/*": false
    }
  },
  "rewrites": [
    {
      "source": "/learn",
      "destination": "/index.html"
    },
    {
      "source": "/glossary",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/coverage",
      "destination": "/index.html"
    },
    {
      "source": "/practice",
      "destination": "/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/index.html"
    },
    {
      "source": "/timeline",
      "destination": "/index.html"
    }
  ]
}
